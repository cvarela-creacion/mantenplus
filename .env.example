# =====================================================================
#  Copia este archivo a .env y completa tus valores. NUNCA subas .env.
# =====================================================================

# ---------------------------------------------------------------------
# INTERRUPTOR CENTRAL DE ENTORNO
#   true  -> Binance Spot Testnet (dinero virtual) https://testnet.binance.vision
#   false -> Binance Producción (DINERO REAL)
# ---------------------------------------------------------------------
SANDBOX_MODE=true

# Llaves separadas por entorno (el bot solo lee las del entorno activo)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Obligatorio para operar con dinero real (SANDBOX_MODE=false y DRY_RUN=false)
# CONFIRM_LIVE_TRADING=YES_I_UNDERSTAND_REAL_MONEY

# DRY_RUN=true: datos reales + IA, pero sin enviar órdenes (simulación con
# capital virtual PAPER_EQUITY). Útil también sin llaves de Binance.
DRY_RUN=false
PAPER_EQUITY=1000

# ---------------------------------------------------------------------
# Mercado
# ---------------------------------------------------------------------
SYMBOLS=BTC/USDT,ETH/USDT
QUOTE_CURRENCY=USDT
TIMEFRAME=15m
OHLCV_LIMIT=300
POLL_INTERVAL_SECONDS=30
MAX_ENTRY_DRIFT_PCT=0.003

# ---------------------------------------------------------------------
# Estrategia local (cálculo gratuito con pandas)
# ---------------------------------------------------------------------
# Solo se consulta a la IA si la confluencia local >= este puntaje (0..1)
MIN_SIGNAL_SCORE=0.75
VOLUME_RATIO_MIN=1.3
ADX_MIN=20

# ---------------------------------------------------------------------
# Gestión de riesgo (SL/TP SIEMPRE obligatorios)
# ---------------------------------------------------------------------
RISK_PER_TRADE_PCT=0.01
MAX_POSITION_PCT=0.25
MAX_OPEN_POSITIONS=2
MAX_DAILY_LOSS_PCT=0.03
MIN_REWARD_RISK=1.8
ATR_SL_MULTIPLIER=1.5
ATR_TP_MULTIPLIER=3.0
MIN_SL_PCT=0.004
MAX_SL_PCT=0.04
# STOP_LOSS (stop a mercado, garantiza salida) | STOP_LOSS_LIMIT
STOP_LOSS_ORDER_TYPE=STOP_LOSS

# ---------------------------------------------------------------------
# Filtro de rentabilidad neta
# ---------------------------------------------------------------------
# Comisiones Binance Spot VIP0 (0.1 %). Con descuento BNB: 0.00075
MAKER_FEE=0.001
TAKER_FEE=0.001
SLIPPAGE_PCT=0.0005
# Beneficio bruto en TP >= N x (comisiones + deslizamiento + IA)
MIN_PROFIT_TO_COST_RATIO=3.0
MAX_BREAKEVEN_PROBABILITY=0.45
MIN_PROBABILITY_EDGE=0.05
MIN_EV_TO_COST_RATIO=1.0

# ---------------------------------------------------------------------
# Comité de inversiones IA (Claude)
# ---------------------------------------------------------------------
AI_ENABLED=true
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (más esfuerzo = más tokens = más costo)
AI_EFFORT=medium
AI_MAX_TOKENS=16000
AI_TIMEOUT_SECONDS=120
# Reintento automático en el servidor si el modelo declina por política
AI_USE_SERVER_FALLBACKS=true
AI_DAILY_BUDGET_USD=2.00
AI_SYMBOL_COOLDOWN_MINUTES=60
AI_EXIT_REVIEW_COOLDOWN_MINUTES=120
# Estimación previa de tokens por consulta (para la compuerta pre-IA)
AI_EST_INPUT_TOKENS=2500
AI_EST_OUTPUT_TOKENS=3000
AI_PRIOR_APPROVAL_RATE=0.35

# ---------------------------------------------------------------------
STATE_DIR=state
LOG_LEVEL=INFO
